(executable
 (modes exe)
 (name gen_powershell_binding)
 (modules gen_powershell_binding gen_powershell_help common_functions)
 (libraries astring CommonFunctions mustache xapi-datamodel))

(test
 (name test_gen_powershell)
 (package xapi-sdk)
 (modules test_gen_powershell)
 (libraries CommonFunctions alcotest fmt mustache xapi-test-utils)
 (deps
  (source_tree test_data)
  (source_tree templates)))

(rule
 (alias generate)
 (targets
  (dir autogen-out))
 (deps
  (:x gen_powershell_binding.exe)
  (source_tree templates)
  (:sh ../windows-line-endings.sh)
  (source_tree autogen))
 (action
  (progn
   (progn
    (bash "cp -r autogen/ autogen-out/")
    (run %{x}))
   (bash "rm autogen-out/.gitignore")
   (bash "%{sh} autogen-out/"))))

(data_only_dirs test_data templates)

(install
 (package xapi-sdk)
 (section share_root)
 (dirs
  (autogen-out as powershell)))
