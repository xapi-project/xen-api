(executable
  (modes exe)
  (name main)
  ; belong to the package, so that dune-build-info reports its version
  (public_name -)
  (package message-switch-cli)
  (libraries
    cmdliner
    message-switch-core
    message-switch-unix
    mtime
    rpclib.core
    rpclib.json
    threads.posix
    unix
    xapi-consts.xapi_version
  )
  (preprocess (pps ppx_deriving_rpc))
)

(install
 (package message-switch-cli)
 (section sbin)
 (files (main.exe as message-cli))
)
