(executables
  (modes exe)
  (names
    client_unix_main
    server_unix_main
    lock_test_lwt
  )
  (modules
    client_unix_main
    server_unix_main
    lock_test_lwt
  )
  (libraries
    message-switch-unix
    message-switch-core
    message-switch-lwt
    threads.posix
    unix
  )
)

(rule
  (alias runtest)
  (deps
    lock_test_lwt.exe
  )
  (action (run ./lock_test_lwt.exe))
  (package message-switch)
)


(rule
  (alias runtest)
  (deps
    client_unix_main.exe
    server_unix_main.exe
    lwt/client_main.exe
    lwt/server_main.exe
    lwt/link_test_main.exe
    ../switch/switch_main.exe
  )
  (action (run ./basic-rpc-test.sh))
  (package message-switch)
)

(rule
  (alias stresstest)
  (deps
    client_unix_main.exe
    server_unix_main.exe
    lwt/client_main.exe
    lwt/server_main.exe
    lwt/link_test_main.exe
    ../switch/switch_main.exe
  )
  (action (setenv SECS 5 (run ./basic-rpc-test.sh)))
  (package message-switch)
)


(rule
  (alias runtest)
  (deps
    client_unix_main.exe
    server_unix_main.exe
    lwt/client_main.exe
    lwt/server_main.exe
    lwt/link_test_main.exe
    ../switch/switch_main.exe
    cli_main.exe
  )
  (action (run ./concur-rpc-test.sh))
  (package message-switch)
)

; A copy of message-cli for the tests of message-switch: the installed one
; belongs to message-switch-cli, so it is not built by dune -p message-switch
(rule
  (copy ../cli/main.ml cli_main.ml)
)

(executable
  (modes exe)
  (name cli_main)
  (public_name -)
  (package message-switch)
  (modules cli_main)
  (libraries
    cmdliner
    message-switch-core
    message-switch-unix
    mtime
    rpclib.core
    rpclib.json
    threads.posix
    unix
    xapi-consts.xapi_version
  )
  (preprocess (pps ppx_deriving_rpc))
)
