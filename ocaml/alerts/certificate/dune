(library
  (name certificate_check)
  (modules certificate_check)
  (modes best)
  (libraries
    astring
    ptime
    xapi-expiry-alerts
    xapi-client
    xapi-consts
    xapi-types
    clock
  )
)

(executable
  (modes exe)
  (name certificate_check_main)
  ; belong to the package, so that dune-build-info reports its version
  (public_name -)
  (package xapi)
  (modules certificate_check_main)
  (libraries
    certificate_check

    http_lib
    xapi-client
    xapi-consts.xapi_version
    xapi-types
    xapi-stdext-pervasives
  )
)

(install
  (files (certificate_check_main.exe as alert-certificate-check))
  (package xapi)
  (section libexec_root)
)
