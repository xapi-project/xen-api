(executable
  (modes exe)
  (name cdrommon)
  ; belong to the package, so that dune-build-info reports its version
  (public_name -)
  (package xapi)
  (libraries
    cdrom
    threads
    unix
    xapi-stdext-unix
  )
)

(install
  (files (cdrommon.exe as cdrommon))
  (section libexec_root)
  (package xapi)
)
